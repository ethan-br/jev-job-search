# Copy this file to .env and fill it in yourself. Never paste a key into a chat or an agent.
# What is set in your shell wins over this file. See docs/SETUP.md.

# --- Decisions (OpenAI Decisions API) ---
# An OpenAI API key. It pays for decision calls only: rating postings, mapping forms, reading pages.
# A ChatGPT subscription does not cover these calls. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# The most one command may spend on decisions, in US dollars. Default 1.00.
DECISIONS_RUN_CAP_USD=
# The most all recorded decision calls together may cost. Set it under your prepaid balance. Default: no budget.
DECISIONS_BUDGET_USD=

# --- Writer (form answers, notes, resumes, cover letters) ---
# The program that writes, as a JSON array: the program first, then its arguments. No shell reads it.
# It uses its own sign-in. The key above is never handed to it. See docs/WRITER.md.
#   A stand-in that writes placeholders, for a first rehearsal with no model at all:
#     WRITER_COMMAND=["node","examples/writers/mock-writer.mjs"]
#   The Codex CLI on your ChatGPT sign-in:
#     WRITER_COMMAND=["node","examples/writers/codex-exec.mjs"]
WRITER_COMMAND=
# Names of environment variables the writer may also see, separated by commas. Usually empty.
WRITER_ENV=
# Ways of paying you accept from the writer: subscription, metered, free, unknown. Default: subscription,free.
WRITER_BILLING=

# --- Browser ---
# Only when Chrome is not in a usual place: the full path of the Chrome or Chromium program.
CHROME_PATH=

# --- Secrets on a machine without the macOS Keychain ---
# The one password your job-board accounts use. On a Mac leave this empty and run
# `npx job-search accounts password`, which keeps it in the Keychain.
JOB_SEARCH_ACCOUNTS_PASSWORD=
