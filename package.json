{
  "name": "job-search",
  "version": "2.0.0",
  "private": true,
  "description": "A local job search and application tool with typed decisions and a configurable writer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "job-search": "./bin/job-search.js"
  },
  "scripts": {
    "setup": "tsx src/cli.ts doctor",
    "doctor": "tsx src/cli.ts doctor",
    "discover": "tsx src/cli.ts discover",
    "apply": "tsx src/cli.ts apply",
    "tailor": "tsx src/cli.ts tailor",
    "log": "tsx src/cli.ts log",
    "status": "tsx src/cli.ts status",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "job-search": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ethan-br/jev-job-search.git"
  },
  "bugs": {
    "url": "https://github.com/ethan-br/jev-job-search/issues"
  },
  "homepage": "https://github.com/ethan-br/jev-job-search",
  "keywords": [
    "job-search",
    "applications",
    "automation"
  ]
}
